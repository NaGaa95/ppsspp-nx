Switch 2 (libounce) for the devkitPro SDL3 Switch video driver, applied after switch-vulkan-window.patch by
scripts/build-switch2.sh: no HID keyboard (libounce ends the program when HID refuses it), and the default
window keeps libounce's per-mode size (1920x1080 handheld, the TV's resolution docked) instead of SDL's
nwindowSetDimensions.

--- a/src/video/switch/SDL_switchkeyboard.c
+++ b/src/video/switch/SDL_switchkeyboard.c
@@ -31,7 +31,10 @@
 
 void SWITCH_InitKeyboard(void)
 {
+#ifndef __SWITCH2__
+    // (not on the Switch 2: libounce ends the program when HID refuses the keyboard)
     hidInitializeKeyboard();
+#endif
     SDL_AddKeyboard(keyboard_id, NULL);
 }
 
@@ -43,6 +46,12 @@
