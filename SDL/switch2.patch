+    (void)scancode;
+    (void)timestamp;
+    return;
+#endif
 
     if (hidGetKeyboardStates(&state, 1)) {
         for (scancode = SDL_SCANCODE_UNKNOWN; scancode < (SDL_Scancode)HidKeyboardKey_RightGui; scancode++) {
